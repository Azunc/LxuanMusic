/* ========== 全局基础 ========== */
QMainWindow {
    background-color: #f2f3f5;
}

QWidget {
    font-family: "Microsoft YaHei", "PingFang SC", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #333333;
    outline: none;
}

/* ========== 顶部标题栏 ========== */
QGroupBox#groupBoxTitle {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e8e8e8;
    padding: 0px;
    margin: 0px;
}

QLabel#labTitle {
    color: #333333;
    font-size: 18px;
    font-weight: bold;
    padding-left: 12px;
}

/* 搜索框 */
QLineEdit#lineeditSearch {
    background-color: #f2f3f5;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 4px 12px 4px 32px;
    color: #333333;
    font-size: 13px;
    min-height: 24px;
    selection-background-color: #e60026;
}
QLineEdit#lineeditSearch:focus {
    background-color: #ffffff;
    border: 1px solid #e60026;
}
QLineEdit#lineeditSearch::placeholder {
    color: #999999;
}

/* 搜索相关按钮 */
QPushButton#btnSearch {
    background: transparent;
    border: none;
    color: #999999;
    font-size: 14px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 14px;
}
QPushButton#btnSearch:hover {
    background-color: #f2f3f5;
    color: #666666;
}

QPushButton#btnClear, QPushButton#btnBack {
    background: transparent;
    border: none;
    color: #666666;
    font-size: 13px;
    padding: 4px 8px;
    border-radius: 4px;
}
QPushButton#btnClear:hover, QPushButton#btnBack:hover {
    background-color: #f2f3f5;
    color: #333333;
}

/* 用户区 */
QLabel#labelUser {
    color: #666666;
    font-size: 13px;
}

QPushButton#btnAvatar {
    background: transparent;
    border: 2px solid #e8e8e8;
    border-radius: 16px;
    padding: 0px;
}
QPushButton#btnAvatar:hover {
    border-color: #e60026;
}

/* 顶部功能按钮 */
QPushButton#btnSetting, QPushButton#btnTheme {
    background: transparent;
    border: none;
    color: #666666;
    font-size: 13px;
    padding: 4px 10px;
    border-radius: 4px;
}
QPushButton#btnSetting:hover, QPushButton#btnTheme:hover {
    background-color: #f2f3f5;
    color: #333333;
}

/* 窗控按钮 */
QPushButton#btnMinimize, QPushButton#btnMinimode {
    background: transparent;
    border: none;
    color: #666666;
    font-size: 14px;
    min-width: 36px;
    min-height: 36px;
    border-radius: 4px;
}
QPushButton#btnMinimize:hover, QPushButton#btnMinimode:hover {
    background-color: #f2f3f5;
    color: #333333;
}

QPushButton#btnClose {
    background: transparent;
    border: none;
    color: #666666;
    font-size: 14px;
    min-width: 36px;
    min-height: 36px;
    border-radius: 4px;
}
QPushButton#btnClose:hover {
    background-color: #ff4d4f;
    color: #ffffff;
}

/* ========== 中间内容区 ========== */
QGroupBox#groupBoxTop {
    background-color: #ffffff;
    border: none;
    padding: 0px;
    margin: 0px;
}

/* 侧边栏滚动区 */
QScrollArea#scrollArea {
    border: none;
    background-color: #f8f9fa;
}
QScrollArea::viewport {
    background-color: #f8f9fa;
}

/* 滚动条 */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #d0d0d0;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #b0b0b0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

/* 侧边栏容器 */
QWidget#sideBarWidget {
    background-color: #f8f9fa;
    border-right: 1px solid #e8e8e8;
}

/*
 * 注意：以下三个按钮是代码动态创建的，
 * 请在 sidebarwidget.cpp 中设置 objectName：
 * m_localBtn->setObjectName("localBtn");
 * m_favBtn->setObjectName("favBtn");
 * m_recommendBtn->setObjectName("recommendBtn");
 */
QPushButton#localBtn, QPushButton#favBtn, QPushButton#recommendBtn {
    text-align: left;
    padding-left: 20px;
    background: transparent;
    border: none;
    color: #444444;
    font-size: 14px;
    height: 40px;
    border-radius: 6px;
    margin: 2px 8px;
}
QPushButton#localBtn:hover, QPushButton#favBtn:hover, QPushButton#recommendBtn:hover {
    background-color: #eeeeee;
}
QPushButton#localBtn:checked, QPushButton#favBtn:checked, QPushButton#recommendBtn:checked {
    background-color: #e6e6e6;
    color: #e60026;
    font-weight: bold;
}

/* CollapsibleGroup 与歌单项 */
CollapsibleGroup {
    background: transparent;
}
CollapsibleGroup QWidget#header {
    background: transparent;
}

PlaylistItem {
    background: transparent;
    border-radius: 4px;
}
PlaylistItem:hover {
    background-color: #f0f0f2;
}

/* ========== 歌曲列表 ========== */
QListWidget#listWidget {
    background: #ffffff;
    border: none;
    outline: none;
    padding: 8px;
}
QListWidget#listWidget::item {
    height: 60px;
    border-radius: 6px;
    padding: 8px 12px;
    margin: 2px 4px;
    color: #333333;
}
QListWidget#listWidget::item:hover {
    background-color: #f5f5f7;
}
QListWidget#listWidget::item:selected {
    background-color: #fff5f5;
    color: #e60026;
}
QListWidget#listWidget::item:selected:!active {
    background-color: #f5f5f7;
    color: #333333;
}

/* ========== 底部播放栏 ========== */
QGroupBox#groupBoxPlay {
    background-color: #ffffff;
    border: none;
    border-top: 1px solid #e8e8e8;
    padding: 0px;
    margin: 0px;
}

/* 歌曲信息 */
QLabel#labSongName {
    color: #333333;
    font-size: 14px;
    font-weight: 500;
}
QLabel#labSinger {
    color: #999999;
    font-size: 12px;
}

/* 歌曲封面按钮 */
QPushButton#btnSong {
    background: transparent;
    border: 1px solid #e8e8e8;
    border-radius: 4px;
    padding: 0px;
}
QPushButton#btnSong:hover {
    border-color: #e60026;
}

QPushButton#btnLove, QPushButton#btnCommentPanel {
    background: transparent;
    border: none;
    color: #999999;
    font-size: 12px;
    padding: 2px 6px;
    border-radius: 4px;
}
QPushButton#btnLove:hover, QPushButton#btnCommentPanel:hover {
    color: #e60026;
    background-color: #fff5f5;
}

/* ========== 进度条 ========== */
QSlider#sliderPosition::groove:horizontal {
    height: 4px;
    background: #e8e8e8;
    border-radius: 2px;
}
QSlider#sliderPosition::sub-page:horizontal {
    background: #e60026;
    border-radius: 2px;
}
QSlider#sliderPosition::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    background: #ffffff;
    border: 2px solid #e60026;
    border-radius: 6px;
}
QSlider#sliderPosition::handle:horizontal:hover {
    background: #e60026;
    border: 2px solid #ffffff;
    width: 14px;
    height: 14px;
    margin: -5px 0;
}

QLabel#labRatio {
    color: #999999;
    font-size: 11px;
}

/* ========== 播放控制按钮 ========== */
/* 播放/暂停 - 圆形主按钮，纯图标容器 */
QPushButton#btnPlay {
    background-color: #e60026;
    border: none;
    border-radius: 20px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    color: #ffffff;
}
QPushButton#btnPlay:hover {
    background-color: #c4001d;
}
QPushButton#btnPlay:pressed {
    background-color: #a00018;
}

/* 上一首/下一首 - 圆形按钮，纯图标容器 */
QPushButton#btnPrevious, QPushButton#btnNext {
    background: transparent;
    border: none;
    color: #333333;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    border-radius: 16px;
}
QPushButton#btnPrevious:hover, QPushButton#btnNext:hover {
    background-color: #f2f3f5;
    color: #e60026;
}
QPushButton#btnPrevious:pressed, QPushButton#btnNext:pressed {
    background-color: #e8e8e8;
}

/* 列表/循环模式 - 小文字按钮 */
QPushButton#btnList, QPushButton#btnLoop {
    background: transparent;
    border: none;
    color: #666666;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 4px;
}
QPushButton#btnList:hover, QPushButton#btnLoop:hover {
    background-color: #f2f3f5;
    color: #333333;
}
QPushButton#btnList:checked, QPushButton#btnLoop:checked {
    color: #e60026;
    font-weight: bold;
}

/* ========== 底部右侧功能按钮 ========== */
QPushButton#btnAudioVisualization, QPushButton#btnFavorite,
QPushButton#btnLyric, QPushButton#btnVolume {
    background: transparent;
    border: 1px solid #e8e8e8;
    border-radius: 4px;
    color: #666666;
    font-size: 12px;
    padding: 4px 10px;
    min-height: 24px;
}
QPushButton#btnAudioVisualization:hover, QPushButton#btnFavorite:hover,
QPushButton#btnLyric:hover, QPushButton#btnVolume:hover {
    background-color: #f8f9fa;
    border-color: #d0d0d0;
    color: #333333;
}
QPushButton#btnAudioVisualization:checked, QPushButton#btnFavorite:checked,
QPushButton#btnLyric:checked, QPushButton#btnVolume:checked {
    background-color: #fff5f5;
    border-color: #e60026;
    color: #e60026;
}

/* ========== 状态栏 ========== */
QStatusBar {
    background-color: #ffffff;
    color: #999999;
    font-size: 11px;
    border-top: 1px solid #e8e8e8;
}
QStatusBar::item {
    border: none;
}
